# SBOM-Shield — Production Environment Variables
# Copy to .env on the production host and fill in real values.
# NEVER commit a populated .env to version control.
#
# Differences from .env.example (dev):
#   - No default/fallback values — everything must be explicitly set
#   - Stronger guidance on secrets generation
#   - CORS_ORIGINS must list only your real domains
#   - NVD_MIRROR_ENABLED recommended true for offline enrichment

# ═══════════════════════════════════════════════════════════════════
# REQUIRED — deployment will fail or be insecure without these
# ═══════════════════════════════════════════════════════════════════

# Generate with: openssl rand -hex 32
SECRET_KEY=

# Use a strong unique password — never the docker-compose default
POSTGRES_PASSWORD=

# Bootstrap admin credentials (created on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ═══════════════════════════════════════════════════════════════════
# NETWORK
# ═══════════════════════════════════════════════════════════════════

# Comma-separated list of trusted frontend origins — no wildcards in prod
CORS_ORIGINS=https://your-domain.example.com

# Public-facing URL used to build password-reset links
APP_URL=https://your-domain.example.com

# JWT expiry in minutes (default 480 = 8 h)
JWT_EXPIRE_MINUTES=480

# Session cookie Secure flag — MUST be true behind HTTPS in production.
# If you terminate TLS at a reverse proxy that does not forward HTTPS to the
# backend, set this to true so the browser still gets a Secure cookie.
COOKIE_SECURE=true

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL ENRICHMENT
# ═══════════════════════════════════════════════════════════════════

# NVD API key — faster CVSS enrichment; get one free at nvd.nist.gov
# NVD_API_KEY=

# Enable local NVD CVE mirror (~4-6 GB extra DB, 2-4 h initial sync)
# Strongly recommended for air-gapped or high-throughput deployments
# NVD_MIRROR_ENABLED=true

# ═══════════════════════════════════════════════════════════════════
# PRE-DEPLOYMENT CHECKLIST
# ═══════════════════════════════════════════════════════════════════
# [ ] SECRET_KEY generated with: openssl rand -hex 32
# [ ] POSTGRES_PASSWORD is strong and unique (never the compose default)
# [ ] ADMIN_PASSWORD meets requirements: 12+ chars, mixed case, digit, special
# [ ] CORS_ORIGINS contains only your production domain(s)
# [ ] APP_URL is your public HTTPS URL
# [ ] Database ports are NOT exposed in docker-compose.yml
# [ ] TLS termination is handled upstream (reverse proxy / load balancer)
# [ ] Backups are configured for the Postgres volume
